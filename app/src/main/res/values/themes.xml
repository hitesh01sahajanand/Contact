<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ContanctManager" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/main_color</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black_color</item>
        <item name="android:windowBackground">@color/bg_color</item>
        <item name="android:statusBarColor">@color/bg_color</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ContanctManager" parent="Base.Theme.ContanctManager" />

    <style name="Theme.NewContact" parent="Theme.ContanctManager">
        <item name="android:fitsSystemWindows">false</item>
    </style>

    <style name="Theme.UCrop" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/grey_color</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#6B7173</item>
        <item name="colorPrimaryDark">#6B7173</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="DialButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NativeAdsView">
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TransparentTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/main_color</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black_color</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="ExitDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/anim_item_from_bottom_anim</item>
        <item name="android:windowExitAnimation">@anim/anim_topbottom_anim</item>
    </style>

    <!-- Theme for CallActivity: shows status bar with visible time & details -->
    <style name="Theme.CallActivity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="OverlayGuideActivity.Theme" parent="@style/Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:windowEnterAnimation">@anim/enter_left_to_right</item>
        <item name="android:windowExitAnimation">@anim/exit_left_to_right</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">0</item>
        <item name="android:showOnLockScreen">true</item>
        <item name="android:ambientShadowAlpha">0</item>
        <item name="android:spotShadowAlpha">0</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="windowNoTitle">true</item>
    </style>

</resources>