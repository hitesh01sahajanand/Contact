<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ContanctManager" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/main_color</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@color/bg_color</item>
        <item name="android:statusBarColor">@color/bg_color</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.ContanctManager" parent="Base.Theme.ContanctManager" />

    <style name="Theme.UCrop" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/grey_color</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#6B7173</item>
        <item name="colorPrimaryDark">#6B7173</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="DialButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NativeAdsView">
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ExitDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/anim_item_from_bottom_anim</item>
        <item name="android:windowExitAnimation">@anim/anim_topbottom_anim</item>
    </style>

</resources>