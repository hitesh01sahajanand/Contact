<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <TextView
            android:id="@+id/buttonReminder"
            style="@style/TextStyle.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginVertical="@dimen/_10sdp"
            android:background="@drawable/bg_create3"
            android:backgroundTint="@color/bg_color"
            android:gravity="center"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/create_reminder"
            android:textColor="@color/black_color"
            android:textSize="@dimen/_13sdp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/linearCreateView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/layoutedit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_create2"
                            android:orientation="vertical"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:paddingVertical="@dimen/_3sdp">


                            <EditText
                                android:id="@+id/edittxt"
                                style="@style/TextStyle.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:background="@null"
                                android:drawableStart="@drawable/iv_edittext_icon"
                                android:drawablePadding="@dimen/_10sdp"
                                android:hint="@string/remind_me_about"
                                android:inputType="textCapWords"
                                android:lines="2"
                                android:maxLines="2"
                                android:paddingHorizontal="@dimen/_3sdp"
                                android:paddingVertical="@dimen/_8sdp"
                                android:singleLine="true"
                                android:textColor="@color/black_color"
                                android:textColorHint="@color/grey_color"
                                android:textSize="@dimen/_11sdp" />


                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/SelectDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="center">


                        <TextView
                            android:id="@+id/add_date_time_reminder"
                            style="@style/TextStyle.Medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_create"
                            android:drawableStart="@drawable/evet_time_start"
                            android:drawablePadding="@dimen/_10sdp"
                            android:gravity="center_vertical"
                            android:hint="@string/select_date_amp_time"
                            android:lines="2"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:textColor="@color/black_color"
                            android:textColorHint="@color/grey_color"
                            android:textSize="@dimen/_12sdp" />
                    </LinearLayout>


                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/linearColor1"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:background="@drawable/iv_circle_bac_icon"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearColor2"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon"
                                    app:tint="#78DCC7" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearColor3"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon"
                                    app:tint="#FF2ED9" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearColor4"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon"
                                    app:tint="#FF6A00" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearColor5"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon"
                                    app:tint="#8F0FFF" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearColor6"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon"
                                    app:tint="#FFC300" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/linearColor7"
                                android:layout_width="@dimen/_32sdp"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/_22sdp"
                                    android:layout_height="@dimen/_22sdp"
                                    android:src="@drawable/iv_circle_color_icon"
                                    app:tint="#00B2FF" />
                            </LinearLayout>


                        </LinearLayout>


                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_10sdp"
                        android:layout_marginTop="@dimen/_30sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/buttonYes"
                            style="@style/TextStyle.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginEnd="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_create2"
                            android:backgroundTint="@color/main_color"
                            android:gravity="center"
                            android:paddingVertical="@dimen/_7sdp"
                            android:text="Yes"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/buttonNo"
                            style="@style/TextStyle.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_weight="1"
                            android:background="@drawable/bg_create2"
                            android:backgroundTint="@color/grey_color"
                            android:gravity="center"
                            android:paddingVertical="@dimen/_7sdp"
                            android:text="No"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_14sdp" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycleView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tv_no_reminder"
                        style="@style/TextStyle.Medium"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:minHeight="@dimen/_100sdp"
                        android:paddingVertical="@dimen/_7sdp"
                        android:text="No Reminder set"
                        android:textColor="@color/black_color"
                        android:textSize="@dimen/_14sdp"
                        android:visibility="gone" />

                </LinearLayout>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </LinearLayout>
</layout>