<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="OnClickHandler"
            type="com.example.contactmanager.utils.OnClickHandler" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_incoming_calls"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/ll_hold_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_new_light"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10sdp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/ic_new_hold" />

                    <TextView
                        android:id="@+id/tv_hold_number"
                        style="@style/TextStyle.Medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="+91 89562 56234 - Hold"
                        android:textColor="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cv_profile" />

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cv_profile"
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_100sdp"
                    android:layout_gravity="center"
                    android:layout_marginTop="?actionBarSize"
                    app:cardBackgroundColor="@color/color_1"
                    app:cardCornerRadius="@dimen/_120sdp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_user_space_holder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/_28sdp"
                        android:src="@drawable/ic_user" />

                    <ImageView
                        android:id="@+id/iv_user_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tv_number_name"
                    style="@style/TextStyle.ExtraLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center"
                    android:text="+91 89562 56234"
                    android:textColor="@color/black_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cv_profile" />

                <TextView
                    android:id="@+id/tv_number"
                    style="@style/TextStyle.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="center"
                    android:text="Mobile +91 89562 56234"
                    android:textColor="@color/grey_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                <Chronometer
                    android:id="@+id/chronometer"
                    style="@style/TextStyle.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:gravity="start"
                    android:textColor="@color/black_color"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_number" />


                <LinearLayout
                    android:id="@+id/ll_all_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:orientation="vertical"
                    android:padding="@dimen/_12sdp"
                    app:layout_constraintBottom_toTopOf="@+id/iv_reject_call"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/chronometer">


                    <LinearLayout
                        android:id="@+id/ll_conference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_20sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:orientation="horizontal"
                        android:visibility="visible">


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:id="@+id/ll_hold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_hold"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_hold"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_hold"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_hold"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/hold"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_video_call"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_video_call"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_video_call"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_video_call"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_video_call"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/video_call"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/ll_swap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_swap"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_swap"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_swap_call"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_swap"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/swap"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/ll_manage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_manage"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_manage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_manage_call"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_manage"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/manage"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_merge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_merge"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_merge"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_merge_call"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_merge"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/merge"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/ll_add_call"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_add_call"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_16sdp"
                                    android:src="@drawable/ic_add_call" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_add_call"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/add_call"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_30sdp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <LinearLayout
                            android:id="@+id/ll_keypad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_keypad"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_keypad"
                                    android:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/keypad"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />


                        </LinearLayout>


                        <LinearLayout
                            android:id="@+id/ll_mute"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_mute"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_mute"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_mute"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_mute"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/mute"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_speaker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_speaker"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_speaker"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_speaker"
                                    app:tint="@color/black_color" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                android:id="@+id/tv_speaker"
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/speaker"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_more"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cv_more"
                                android:layout_width="@dimen/_50sdp"
                                android:layout_height="@dimen/_50sdp"
                                app:cardBackgroundColor="@color/bg_color"
                                app:cardCornerRadius="@dimen/_50sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="@dimen/_15sdp"
                                    android:src="@drawable/ic_more" />
                            </androidx.cardview.widget.CardView>


                            <TextView
                                style="@style/TextStyle.Medium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:gravity="center"
                                android:text="@string/more"
                                android:textColor="@color/black_color"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_number_name" />


                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_reject_call"
                    android:layout_width="@dimen/_60sdp"
                    android:layout_height="@dimen/_60sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                    android:src="@drawable/ic_call_reject"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_all_buttons" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>