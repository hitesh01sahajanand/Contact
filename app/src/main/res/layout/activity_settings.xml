<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="OnClickHandler"
            type="com.example.contactmanager.utils.OnClickHandler" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:orientation="vertical"
        tools:context=".activities.settings.SettingsActivity">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_35sdp"
                android:contentDescription="@string/setting"
                android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/TextStyle.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/setting"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:orientation="vertical">


                <TextView
                    style="@style/TextStyle.Regular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="start"
                    android:text="@string/call_assist"
                    android:textColor="@color/black_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/all_rounded_corner_bg"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/ll_caller_id_disable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp"
                        android:visibility="visible">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_caller_id" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/caller_id_disables"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_show_confirmation_dialog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:src="@drawable/ic_call_information" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/show_a_call_confirmation"
                            android:textColor="@color/black_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_confirm_dialog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:thumb="@drawable/thumb_selector"
                            app:thumbTint="@null"
                            app:track="@drawable/track_selector"
                            app:trackTint="@null" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    style="@style/TextStyle.Regular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:gravity="start"
                    android:text="@string/personalisation"
                    android:textColor="@color/black_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/all_rounded_corner_bg"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/ll_app_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{ (v)-> OnClickHandler.onClick(v) }"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:src="@drawable/ic_app_theme" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/app_theme"
                            android:textColor="@color/black_color" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_theme_type"
                                style="@style/TextStyle.Small"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/light_mode_app"
                                android:textColor="@color/setting_grey_color" />

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:rotation="180"
                                android:src="@drawable/ic_back_arrow"
                                app:tint="@color/black_color" />

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_language"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_language" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/language"
                            android:textColor="@color/black_color" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!--<TextView
                                android:id="@+id/tv_language"
                                style="@style/TextStyle.Small"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="@dimen/_10sdp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/system_english"
                                android:textColor="@color/setting_grey_color" />-->

                            <ImageView
                                android:layout_width="@dimen/_16sdp"
                                android:layout_height="@dimen/_16sdp"
                                android:rotation="180"
                                android:src="@drawable/ic_back_arrow"
                                app:tint="@color/black_color" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <TextView
                    style="@style/TextStyle.Regular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_vertical"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:gravity="start"
                    android:text="@string/general"
                    android:textColor="@color/black_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/all_rounded_corner_bg"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/ll_block_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:src="@drawable/ic_block_number" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/block_number"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_speed_dial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:src="@drawable/ic_speed_dialer" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/speed_dial"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_quick_response"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_quick_response" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/quick_response"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_sound_vibration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_vibration" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/sound_vibration"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_sim_pref"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_sim_pref" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/sim_preference"
                            android:textColor="@color/black_color" />

                        <TextView
                            android:id="@+id/tv_sim_pref"
                            style="@style/TextStyle.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Always ask"
                            android:textColor="@color/setting_grey_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_merge_duplicate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_merge_duplicate" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/merge_duplicate_contacts"
                            android:textColor="@color/black_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_merge_duplicate_contact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:thumb="@drawable/thumb_selector"
                            app:thumbTint="@null"
                            app:track="@drawable/track_selector"
                            app:trackTint="@null" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_dial_pad_sound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp"
                        tools:ignore="UseSwitchCompatOrMaterialXml">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:src="@drawable/ic_dial_pad_sound" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/dial_pad_sound"
                            android:textColor="@color/black_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_dial_pad_sound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:thumb="@drawable/thumb_selector"
                            app:thumbTint="@null"
                            app:track="@drawable/track_selector"
                            app:trackTint="@null" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_flash_call"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_flash" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/show_flash_on_call"
                            android:textColor="@color/black_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_call_flash"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:thumb="@drawable/thumb_selector"
                            app:thumbTint="@null"
                            app:track="@drawable/track_selector"
                            app:trackTint="@null" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_use_swipe_action"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_swape_action" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/use_swipe_to_action"
                            android:textColor="@color/black_color" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_swipe_action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:thumb="@drawable/thumb_selector"
                            app:thumbTint="@null"
                            app:track="@drawable/track_selector"
                            app:trackTint="@null" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_change_ringtone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_change_ring" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/change_ringtone"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_export_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
                        android:gravity="center_vertical"
                        android:onClick="@{(v) -> OnClickHandler.onClick(v)}"
                        android:orientation="horizontal"
                        android:padding="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:contentDescription="@string/caller_id_disables"
                            android:src="@drawable/ic_export" />

                        <TextView
                            style="@style/TextStyle.Regular"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginHorizontal="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:text="@string/export_contacts"
                            android:textColor="@color/black_color" />

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:rotation="180"
                            android:src="@drawable/ic_back_arrow"
                            app:tint="@color/black_color" />


                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_import_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ripple_effect_bg"
