<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="OnClickHandler"
            type="com.phonecall.dialcontacts.calldialer.utils.OnClickHandler" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color"
        android:fitsSystemWindows="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@color/bg_color"
            android:orientation="vertical"
            tools:context=".activities.endCall.EndCallActivity">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:background="@drawable/new_all_rounded_corner"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_10sdp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_add_photo"
                        android:layout_width="@dimen/_60sdp"
                        android:layout_height="@dimen/_60sdp"
                        android:layout_gravity="start"
                        android:onClick="@{ (v) -> OnClickHandler.onClick(v)}"
                        app:cardBackgroundColor="@color/color_3"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="true"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.ContactManager.Circle"
                        app:strokeColor="@color/border_color"
                        app:strokeWidth="0.5dp">

                        <ImageView
                            android:id="@+id/iv_contact_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <ImageView
                            android:id="@+id/iv_user"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="@dimen/_18sdp"
                            android:src="@drawable/ic_user"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_first_name"
                            style="@style/TextStyle.ExtraLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text=""
                            android:textColor="@color/white"
                            android:visibility="visible" />

                    </com.google.android.material.card.MaterialCardView>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_title"
                                style="@style/TextStyle.MediumSemiBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:ellipsize="end"
                                android:gravity="start"
                                android:singleLine="true"
                                android:text=""
                                android:textColor="@color/black_color"
                                android:visibility="visible" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/_5sdp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_time"
                                    style="@style/TextStyle.Medium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:gravity="start"
                                    android:singleLine="true"
                                    android:text=""
                                    android:textColor="@color/black_color"
                                    android:visibility="visible" />

                                <TextView
                                    android:id="@+id/tv_call_type"
                                    style="@style/TextStyle.Medium"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginStart="@dimen/_10sdp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:gravity="start"
                                    android:singleLine="true"
                                    android:text=""
                                    android:textColor="@color/grey_color"
                                    android:visibility="visible" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_duration"
                                style="@style/TextStyle.Medium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="start"
                                android:text=""
                                android:textColor="@color/black_color"
                                android:visibility="visible" />

                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="@dimen/_5sdp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/iv_call"
                                android:layout_width="@dimen/_28sdp"
                                android:layout_height="@dimen/_28sdp"
                                android:src="@mipmap/ic_launcher_round" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>


                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:background="@color/border_color" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_10sdp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ll_call"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:onClick="@{ (v) -> OnClickHandler.onClick(v)}"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:src="@drawable/ic_call_info" />

                        <TextView
                            style="@style/TextStyle.MediumSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:gravity="center"
                            android:text="@string/call"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/_11sdp"
                            android:visibility="visible" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_add_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:onClick="@{ (v) -> OnClickHandler.onClick(v)}"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:src="@drawable/ic_add_contact_" />

                        <TextView
                            style="@style/TextStyle.MediumSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:gravity="center"
                            android:singleLine="true"
                            android:text="@string/add_contact"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/_11sdp"
                            android:visibility="visible" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_sms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:onClick="@{ (v) -> OnClickHandler.onClick(v)}"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:src="@drawable/ic_message_info" />

                        <TextView
                            style="@style/TextStyle.MediumSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:gravity="center"
                            android:text="@string/sms"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/_11sdp"
                            android:visibility="visible" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_contact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:onClick="@{ (v) -> OnClickHandler.onClick(v)}"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:src="@drawable/ic_contact_" />

                        <TextView
                            style="@style/TextStyle.MediumSemiBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:gravity="center"
                            android:text="@string/contact"
                            android:textColor="@color/black_color"
                            android:textSize="@dimen/_11sdp"
                            android:visibility="visible" />

                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_10sdp"
                app:cardBackgroundColor="@color/main_color"
                app:cardCornerRadius="@dimen/_10sdp"
                app:strokeWidth="0dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/wsfw_tabslayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="7dp"
                    android:background="@color/main_color"
                    app:tabIconTint="@color/tab_icon_selector"
                    app:tabIndicatorColor="@color/white_" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginVertical="@dimen/_10sdp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_10sdp"
                app:strokeWidth="0dp">

                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/wsfw_viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp" />

            </com.google.android.material.card.MaterialCardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/linearBannerShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:background="@drawable/bg_create"
                        android:backgroundTint="@color/bg_view"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/lehfv_shimmer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingLeft="5dp"
                            android:paddingRight="5dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:minHeight="50dp"
                                android:orientation="vertical"
                                android:paddingLeft="5dp"
                                android:paddingTop="5dp"
                                android:paddingRight="5dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/ad_view"
                                        android:paddingLeft="@dimen/_5sdp"
                                        android:paddingTop="@dimen/_2sdp"
                                        android:paddingRight="@dimen/_5sdp"
                                        android:paddingBottom="@dimen/_2sdp"
                                        android:text="Ad"
                                        android:textColor="@color/white"
                                        android:textSize="@dimen/_8sdp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <ImageView
                                            android:id="@+id/lehfv_logo"
                                            android:layout_width="50dp"
                                            android:layout_height="50dp"
                                            android:layout_margin="@dimen/_5sdp"
                                            android:adjustViewBounds="true"
                                            android:background="#AAA8A8" />

                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="@dimen/_10sdp"
                                            android:layout_marginRight="@dimen/_10sdp"
                                            android:gravity="center"
                                            android:orientation="vertical">

                                            <TextView
                                                android:id="@+id/lehfv_top_line"
                                                style="@style/TextStyle.MediumSemiBold"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="#AAA8A8"
                                                android:includeFontPadding="false"
                                                android:textColor="@color/black_color"
                                                android:textSize="@dimen/_12sdp" />

                                            <LinearLayout
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:gravity="center">

                                                <TextView
                                                    android:id="@+id/lehfv_advertisment"
                                                    style="@style/TextStyle.Medium"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="match_parent"
                                                    android:gravity="bottom"
                                                    android:includeFontPadding="false"
                                                    android:singleLine="true"
                                                    android:textColor="@color/black_color"
                                                    android:textSize="12sp"
                                                    android:textStyle="bold" />

                                                <RatingBar
                                                    android:id="@+id/lehfv_rate_stars"
                                                    style="?android:attr/ratingBarStyleSmall"
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:isIndicator="true"
                                                    android:numStars="5"
                                                    android:stepSize="0.5" />

                                                <LinearLayout
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginLeft="@dimen/_10sdp"
                                                    android:layout_weight="1"
                                                    android:gravity="end"
                                                    android:orientation="horizontal">

                                                    <TextView
                                                        android:id="@+id/lehfv_fees"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:paddingStart="5dp"
                                                        android:paddingLeft="5dp"
                                                        android:paddingEnd="5dp"
                                                        android:paddingRight="5dp"
                                                        android:singleLine="true"
                                                        android:textColor="@color/black_color"
                                                        android:textSize="12sp" />

                                                    <TextView
                                                        android:id="@+id/lehfv_store"
                                                        android:layout_width="wrap_content"
                                                        android:layout_height="wrap_content"
                                                        android:paddingStart="5dp"
                                                        android:paddingLeft="5dp"
                                                        android:paddingEnd="5dp"
                                                        android:paddingRight="5dp"
                                                        android:singleLine="true"
                                                        android:textColor="@color/black_color"
                                                        android:textSize="12sp" />

                                                </LinearLayout>

                                            </LinearLayout>

                                            <TextView
                                                android:id="@+id/lehfv_body"
                                                style="@style/TextStyle.Medium"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="#AAA8A8"
                                                android:ellipsize="end"
                                                android:includeFontPadding="false"
                                                android:maxLines="1"
                                                android:textColor="@color/black_color"
                                                android:textSize="@dimen/_10sdp" />

                                        </LinearLayout>

                                    </LinearLayout>

                                    <com.google.android.gms.ads.nativead.MediaView
                                        android:id="@+id/lehfv_media_view"
                                        android:layout_width="250dp"
                                        android:layout_height="155dp"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="5dp"
                                        android:background="#AAA8A8" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">

                                        <androidx.cardview.widget.CardView
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:layout_margin="@dimen/_5sdp"
                                            app:cardBackgroundColor="@android:color/transparent"
                                            app:cardCornerRadius="@dimen/_5sdp">

                                            <TextView
                                                android:id="@+id/lehfv_install_button"
                                                style="@style/TextStyle.MediumSemiBold"
                                                android:layout_width="match_parent"
                                                android:layout_height="wrap_content"
                                                android:background="@drawable/bg_create"
                                                android:backgroundTint="#AAA8A8"
                                                android:gravity="center"
                                                android:includeFontPadding="false"
                                                android:padding="@dimen/_10sdp"
                                                android:textColor="@color/white"
                                                android:textSize="16sp" />

                                        </androidx.cardview.widget.CardView>

                                    </LinearLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/adContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rlFullAd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/fullAdContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/ivClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/_8sdp"
                android:padding="@dimen/_3sdp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_23sdp"
                    android:layout_height="@dimen/_23sdp"
                    android:background="@drawable/round_bg_one"
                    android:backgroundTint="@color/exo_black_opacity_60"
                    android:padding="@dimen/_3sdp"
                    android:src="@drawable/ic_close_black_24dp"
                    android:tint="@color/white" />

            </LinearLayout>

        </RelativeLayout>
    </LinearLayout>


</layout>